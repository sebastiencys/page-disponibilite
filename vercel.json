{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "fonts/**"
    }
  },
  "rewrites": [
    { "source": "/badge.png", "destination": "/api/badge?format=png" },
    { "source": "/badge.svg", "destination": "/api/badge?format=svg" },
    { "source": "/api/badge.png", "destination": "/api/badge?format=png" },
    { "source": "/api/badge.svg", "destination": "/api/badge?format=svg" },
    { "source": "/api/status", "destination": "/api/status" },
    { "source": "/api/sync", "destination": "/api/sync" },
    { "source": "/api/fetch-ics", "destination": "/api/fetch-ics" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/badge(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0, proxy-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" }
      ]
    }
  ]
}
