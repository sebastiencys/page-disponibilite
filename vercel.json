{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "fonts/**"
    }
  },
  "rewrites": [
    { "source": "/badge.png", "destination": "/api/badge?format=png" },
    { "source": "/badge.svg", "destination": "/api/badge?format=svg" },
    { "source": "/badge.json", "destination": "/api/badge?format=json" },
    { "source": "/api/badge.png", "destination": "/api/badge?format=png" },
    { "source": "/api/badge.svg", "destination": "/api/badge?format=svg" },
    { "source": "/api/badge.json", "destination": "/api/badge?format=json" },
    { "source": "/api/status", "destination": "/api/status" },
    { "source": "/api/calendar-refresh", "destination": "/api/calendar-refresh" },
    { "source": "/api/health", "destination": "/api/health" },
    { "source": "/api/sync", "destination": "/api/sync" },
    { "source": "/api/fetch-ics", "destination": "/api/fetch-ics" },
    { "source": "/api/studio-auth", "destination": "/api/studio-auth" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/badge(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0, proxy-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, POST, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, If-None-Match" },
        { "key": "Access-Control-Expose-Headers", "value": "ETag" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
