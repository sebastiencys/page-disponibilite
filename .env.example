# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CALENDAR_ICS_URL: URL secrète au format iCal (ex: Google Calendar, Outlook, ou Apple Calendar)
# Permet de synchroniser votre agenda en toute sécurité côté serveur (Vercel ou local) sans jamais exposer l'adresse aux destinataires.
CALENDAR_ICS_URL=""

# TIMEZONE: Fuseau horaire IANA pour le calcul précis des horaires de travail et de l'heure locale
# Exemples: "Europe/Paris", "America/New_York", "Europe/London", "Asia/Tokyo"
# Par défaut: "Europe/Paris"
TIMEZONE="Europe/Paris"
