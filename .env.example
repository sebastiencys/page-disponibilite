# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CALENDAR_ICS_URL: URL secrète au format iCal (ex: Google Calendar, Outlook, ou Apple Calendar)
# Permet de synchroniser votre agenda en toute sécurité côté serveur (Vercel ou local) sans jamais exposer l'adresse aux destinataires.
CALENDAR_ICS_URL=""

# Multi-agendas avec label (optionnel) : ajoutez une variable par calendrier sous la forme CALENDAR_ICS_URL_<LABEL>
# Exemples :
#   CALENDAR_ICS_URL_PRO="https://..."         -> label affiché : "Pro"
#   CALENDAR_ICS_URL_PERSO="https://..."       -> label affiché : "Perso"
#   CALENDAR_ICS_URL_CABINET_SUD="https://..." -> label affiché : "Cabinet Sud"
# Vous pouvez aussi forcer un libellé exact (accents, majuscules) via CALENDAR_ICS_LABEL_<LABEL>="Clinique SMR" (ou CALENDAR_ICS_LABEL pour l'agenda principal).

# TIMEZONE: Fuseau horaire IANA pour le calcul précis des horaires de travail et de l'heure locale
# Exemples: "Europe/Paris", "America/New_York", "Europe/London", "Asia/Tokyo"
# Par défaut: "Europe/Paris"
TIMEZONE="Europe/Paris"

# STUDIO_PASSWORD: Mot de passe pour protéger et masquer l'accès au Studio (générateur de signature, simulateur, réglages)
# Laissez vide pour laisser le Studio accessible, ou définissez un mot de passe fort pour le verrouiller.
STUDIO_PASSWORD=""

# Configuration 100 % via .env (optionnel : remplace config/personal.json et config/schedule.json en 2 variables, générables depuis le Studio) :
# PERSONAL_JSON='{"name":"Prénom Nom","role":"Votre Poste","company":"Votre Entreprise","email":"","bookingUrl":"","mode":"person"}'
# SCHEDULE_JSON='{"timezone":"Europe/Paris","days":{"1":{"enabled":true,"start":"09:00","end":"18:00"}},"lunchBreak":{"enabled":true,"start":"12:30","end":"13:30","label":"Pause déjeuner"},"bufferMinutes":0}'

# Surcharges individuelles optionnelles (prioritaires sur PERSONAL_JSON si définies) :
# PROFILE_NAME="Prénom Nom"
# PROFILE_ROLE="Votre Poste / Spécialité"
# PROFILE_COMPANY="Votre Entreprise / Établissement"
# PROFILE_EMAIL=""
# PROFILE_BOOKING_URL=""
# PROFILE_MODE="person"

# Surcharges granulaires optionnelles des horaires (prioritaires sur SCHEDULE_JSON et config/schedule.json) :
# Suffixes jour acceptés : _MON/_LUN/_1, _TUE/_MAR/_2, _WED/_MER/_3, _THU/_JEU/_4, _FRI/_VEN/_5, _SAT/_SAM/_6, _SUN/_DIM/_0
# SCHEDULE_TIMEZONE="Europe/Paris"              # Prioritaire sur TIMEZONE si défini
# SCHEDULE_WORK_DAYS="mon-fri"                  # Ou "mar,mer,jeu,ven", "1,2,3,4,5", "none"
# SCHEDULE_HOURS="09:00-18:00"                  # Plage globale par défaut (ou SCHEDULE_START + SCHEDULE_END)
# SCHEDULE_HOURS_FRI="09:00-17:00"              # Horaire spécifique pour un jour (ou "off" / "repos" pour fermer)
# SCHEDULE_START_MON="08:30"                    # Ou surcharge début/fin seule (SCHEDULE_END_MON="17:30")
# SCHEDULE_DAY_SAT="false"                      # Active/désactive un jour précis (true/false)
# SCHEDULE_LUNCH_HOURS="12:30-13:30"            # Pause déjeuner globale (ou "off", ou SCHEDULE_LUNCH_START/END)
# SCHEDULE_LUNCH_LABEL="Pause déjeuner"         # Libellé de pause déjeuner
# SCHEDULE_LUNCH_HOURS_THU="12:00-12:30"        # Surcharge pause d'un jour précis
# SCHEDULE_LUNCH_ENABLED_WED="false"            # Désactive la pause déjeuner un jour précis
# SCHEDULE_BUFFER_MINUTES="0"                   # Marge (min) avant/après chaque RDV
# SCHEDULE_CLOSURES="12-25|Noël|annual; 2026-08-01..2026-08-15|Congés d'été|vacation"
